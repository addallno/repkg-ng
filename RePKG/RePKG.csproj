<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>RePKG</RootNamespace>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net472;net8.0</TargetFrameworks>
        <Version>0.5.1</Version>
        <Copyright>Copyright © NotScuffed 2025</Copyright>
        <PackAsTool Condition="'$(TargetFramework)' != 'net472'">true</PackAsTool>
        <ToolCommandName>repkg</ToolCommandName>
        <PackageId>RePKG</PackageId>
        <Authors>NotScuffed;addallno</Authors>
        <Description>Wallpaper Engine PKG/TEX packer, extractor and converter. Supports pack/info/extract commands, video textures, and Android .mpkg format.</Description>
        <PackageProjectUrl>https://github.com/addallno/repkg</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>wallpaper-engine;tex;pkg;mpkg;android-wallpaper</PackageTags>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\RePKG.Application\RePKG.Application.csproj" />
        <ProjectReference Include="..\RePKG.Core\RePKG.Core.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ProjectDir)/../THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
